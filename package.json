  "devDependencies": {
    "@fable-org/fable-compiler-js": "3.8.1",
    "@fable-org/fable-library-js": "2.8.1",
    "bun-pty": "0.4.10",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
