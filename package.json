{
  "name": "wanxiangli",
  "version": "0.11.0",
  "private": true,
  "description": "Independent work, journal, process, trace and resource ownership libraries, written in F#.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./work": {
      "types": "./src/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/Work.js"
    },
    "./eventstore": {
      "types": "./src/eventstore/index.d.ts",
      "import": "./dist/eventstore/SqliteJournal.js"
    },
    "./durable-work": {
      "types": "./src/assembly/index.d.ts",
      "import": "./dist/assembly/DurableWork.js"
    },
    "./process": {
      "types": "./src/process/index.d.ts",
      "import": "./dist/process/ProcessSession.js"
    },
    "./trace": {
      "types": "./src/trace/index.d.ts",
      "import": "./dist/trace/Trace.js"
    },
    "./ownership": {
      "types": "./src/session/index.d.ts",
      "import": "./dist/session/Ownership.js"
    },
    "./identity": {
      "types": "./src/identity/index.d.ts",
      "import": "./dist/identity/Identity.js"
    },
    "./events": {
      "types": "./src/events/index.d.ts",
      "import": "./dist/events/CanonicalEventCodec.js"
    },
    "./resources": {
      "types": "./src/resources/index.d.ts",
      "import": "./dist/resources/Resources.js"
    },
    "./fs": {
      "types": "./src/fs/index.d.ts",
      "import": "./dist/fs/Filesystem.js"
    },
    "./time": {
      "types": "./src/time/index.d.ts",
      "import": "./dist/time/Time.js"
    },
    "./wait": {
      "types": "./src/wait/index.d.ts",
      "import": "./dist/wait/Wait.js"
    },
    "./delivery": {
      "types": "./src/delivery/index.d.ts",
      "import": "./dist/delivery/Delivery.js"
    },
    "./prefix": {
      "types": "./src/prefix/index.d.ts",
      "import": "./dist/prefix/Prefix.js"
    },
    "./degeneration": {
      "types": "./src/degeneration/index.d.ts",
      "import": "./dist/degeneration/Degeneration.js"
    }
  },
  "files": [
    "dist/",
    "resources/",
    "src/lifecycle/index.d.ts",
    "src/eventstore/index.d.ts",
    "src/assembly/index.d.ts",
    "src/process/index.d.ts",
    "src/trace/index.d.ts",
    "src/session/index.d.ts",
    "src/identity/index.d.ts",
    "src/events/index.d.ts",
    "src/resources/index.d.ts",
    "src/fs/index.d.ts",
    "src/time/index.d.ts",
    "src/wait/index.d.ts",
    "src/delivery/index.d.ts",
    "src/prefix/index.d.ts",
    "src/degeneration/index.d.ts",
    "README.md",
    "PROCESS.md",
    "TRACE.md",
    "OWNERSHIP.md",
    "MIGRATION.md",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test src/lifecycle/tests/*.test.mjs src/eventstore/tests/*.test.mjs src/assembly/tests/*.test.mjs src/process/tests/*.test.mjs src/trace/tests/*.test.mjs src/session/tests/*.test.mjs src/resources/tests/*.test.mjs src/identity/tests/*.test.mjs src/events/tests/*.test.mjs src/fs/tests/*.test.mjs src/time/tests/*.test.mjs src/wait/tests/*.test.mjs src/prefix/tests/*.test.mjs src/delivery/tests/*.test.mjs src/degeneration/tests/*.test.mjs scripts/tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@fable-org/fable-compiler-js": "3.8.1",
    "@fable-org/fable-library-js": "2.8.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
