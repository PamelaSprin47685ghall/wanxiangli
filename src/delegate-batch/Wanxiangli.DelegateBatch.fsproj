<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DelegateBatchLawCore.fs" />
    <Compile Include="DeferredInspectionStore.fs" />
    <Compile Include="JoinGuardReservationStore.fs" />
    <Compile Include="RetiredDelegateRegistry.fs" />
    <Compile Include="SyncDelegateBatchStore.fs" />
    <Compile Include="DelegateBatchLaw.fs" />
    <PackageExport Include="DelegateBatchLaw.fs" Member="DelegateBatchLaw" />
    <PackageExport Include="DeferredInspectionStore.fs" Member="DeferredInspectionStore" />
    <PackageExport Include="DeferredInspectionStore.fs" Member="deferredInspectionStore" />
    <PackageExport Include="JoinGuardReservationStore.fs" Member="JoinGuardScope" />
    <PackageExport Include="JoinGuardReservationStore.fs" Member="JoinGuardReservationStore" />
    <PackageExport Include="JoinGuardReservationStore.fs" Member="joinGuardReservationStore" />
    <PackageExport Include="RetiredDelegateRegistry.fs" Member="RetiredDelegateRegistry" />
    <PackageExport Include="RetiredDelegateRegistry.fs" Member="retiredDelegateRegistry" />
    <PackageExport Include="SyncDelegateBatchStore.fs" Member="SyncDelegateBatchStore" />
    <PackageExport Include="SyncDelegateBatchStore.fs" Member="syncDelegateBatchStore" />
  </ItemGroup>
</Project>
