<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="CasebookSettlementOwner.fs" />
    <Compile Include="CasebookMaintenanceLaw.fs" />
    <PackageExport Include="CasebookSettlementOwner.fs" Member="CasebookSettlementOwner" />
    <PackageExport Include="CasebookMaintenanceLaw.fs" Member="CasebookMaintenanceLaw" />
  </ItemGroup>
</Project>
