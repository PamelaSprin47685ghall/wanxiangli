<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Wire.fs" />
    <Compile Include="Generation.fs" />
    <Compile Include="WireLaw.fs" />
    <Compile Include="Prefix.fs" />
    <PackageExport Include="Prefix.fs" Member="Prefix" />
    <PackageExport Include="Prefix.fs" Member="PrefixHistory" />
  </ItemGroup>
</Project>
