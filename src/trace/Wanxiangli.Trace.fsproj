<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Wire.fs" />
    <Compile Include="Observation.fs" />
    <Compile Include="Trace.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageExport Include="Trace.fs" Member="Trace" />
    <PackageExport Include="Trace.fs" Member="TraceHistory" />
    <PackageExport Include="Trace.fs" Member="materializeTraceItems" />
    <PackageExport Include="Trace.fs" Member="inspectTraceItems" />
  </ItemGroup>
</Project>
