<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="WriterSegments.fs" />
    <Compile Include="SegmentedWriter.fs" />
    <PackageExport Include="WriterSegments.fs" Member="WriterSegments" />
    <PackageExport Include="SegmentedWriter.fs" Member="SegmentedWriter" />
  </ItemGroup>
</Project>
