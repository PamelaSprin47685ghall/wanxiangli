<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wanxiangli.Capability</RootNamespace>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="OfficeMatrix.fs" />
    <Compile Include="LiveHostConfigStore.fs" />
    <Compile Include="Capability.fs" />
    <PackageExport Include="Capability.fs" Member="Capability" />
    <PackageExport Include="LiveHostConfigStore.fs" Member="LiveHostConfigStore" />
  </ItemGroup>
</Project>
