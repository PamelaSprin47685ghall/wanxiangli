<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wanxiangli.Failure</RootNamespace>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ProviderAttemptStopFence.fs" />
    <Compile Include="ExecutionFailurePolicy.fs" />
    <PackageExport Include="ExecutionFailurePolicy.fs" Member="ExecutionFailurePolicy" />
    <PackageExport Include="ProviderAttemptStopFence.fs" Member="ProviderAttemptStopFence" />
    <PackageExport Include="ProviderAttemptStopFence.fs" Member="providerAttemptStopFence" />
  </ItemGroup>
</Project>
