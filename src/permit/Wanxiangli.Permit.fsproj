<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wanxiangli.Permit</RootNamespace>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ExecutionPermits.fs" />
    <PackageExport Include="ExecutionPermits.fs" Member="ExecutionPermits" />
    <PackageExport Include="ExecutionPermits.fs" Member="CapacityTransitionCounters" />
    <PackageExport Include="ExecutionPermits.fs" Member="capacityTransitionCounters" />
    <PackageExport Include="ExecutionPermits.fs" Member="SessionLeaseHandles" />
    <PackageExport Include="ExecutionPermits.fs" Member="sessionLeaseHandles" />
  </ItemGroup>
</Project>
