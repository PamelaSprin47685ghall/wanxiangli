<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BookkeeperStaging.fs" />
    <Compile Include="SessionDraftStore.fs" />
    <Compile Include="CasebookIndexLaw.fs" />
    <PackageExport Include="BookkeeperStaging.fs" Member="BookkeeperStaging" />
    <PackageExport Include="BookkeeperStaging.fs" Member="bookkeeperStaging" />
    <PackageExport Include="SessionDraftStore.fs" Member="SessionDraftStore" />
    <PackageExport Include="SessionDraftStore.fs" Member="sessionDraftStore" />
    <PackageExport Include="CasebookIndexLaw.fs" Member="CasebookIndexLaw" />
  </ItemGroup>
</Project>
