    <PackageExport Include="spool/OutputSpool.fs" Member="OutputSpool" />
    <PackageExport Include="time/Time.fs" Member="Time" />
    <PackageExport Include="FileSession.fs" Member="FileSession" />
    <PackageExport Include="Tools.fs" Member="RuntimeTools" />
    <PackageExport Include="Runtime.fs" Member="Runtime" />
  </ItemGroup>
</Project>
