    <Compile Include="files/GlobFs.fs" />
    <Compile Include="files/AnchorFs.fs" />
    <Compile Include="files/MutationFs.fs" />
    <Compile Include="files/Filesystem.fs" />
    <Compile Include="process/Native.fs" />
    <Compile Include="process/OutputTail.fs" />
    <Compile Include="process/ProcessSession.fs" />
    <Compile Include="process/LargeGate.fs" />
    <Compile Include="pty/Native.fs" />
    <Compile Include="pty/Terminal.fs" />
    <Compile Include="spool/Native.fs" />
    <Compile Include="spool/OutputSpool.fs" />
    <Compile Include="time/Temporal.fs" />
    <Compile Include="time/Deadline.fs" />
