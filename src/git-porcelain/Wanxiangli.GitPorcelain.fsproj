<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wanxiangli.GitPorcelain</RootNamespace>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="RuntimePathStore.fs" />
    <Compile Include="GitPorcelain.fs" />
    <PackageExport Include="RuntimePathStore.fs" Member="RuntimePathStore" />
    <PackageExport Include="RuntimePathStore.fs" Member="runtimePathStore" />
    <PackageExport Include="GitPorcelain.fs" Member="GitPorcelain" />
  </ItemGroup>
</Project>
