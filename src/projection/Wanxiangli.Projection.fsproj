<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wanxiangli.Projection</RootNamespace>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ToolResultBound.fs" />
    <Compile Include="Projection.fs" />
    <PackageExport Include="Projection.fs" Member="Projection" />
    <PackageExport Include="ToolResultBound.fs" Member="ToolResultBoundStore" />
    <PackageExport Include="ToolResultBound.fs" Member="toolResultBound" />
  </ItemGroup>
</Project>
