<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AttachmentLeaseRegistry.fs" />
    <Compile Include="AttachmentLeaseLaw.fs" />
    <PackageExport Include="AttachmentLeaseLaw.fs" Member="AttachmentLeaseLaw" />
    <PackageExport Include="AttachmentLeaseRegistry.fs" Member="AttachmentLeaseRegistry" />
    <PackageExport Include="AttachmentLeaseRegistry.fs" Member="attachmentLeaseRegistry" />
  </ItemGroup>
</Project>
