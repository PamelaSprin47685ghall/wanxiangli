<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Fable-only compilation unit. No dotnet build; see AGENTS.md. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MessageVisibilityHub.fs" />
    <Compile Include="Terminal.fs" />
    <PackageExport Include="Terminal.fs" Member="TerminalOutcome" />
    <PackageExport Include="Terminal.fs" Member="TerminalRegistry" />
    <PackageExport Include="Terminal.fs" Member="TerminalBus" />
    <PackageExport Include="MessageVisibilityHub.fs" Member="MessageVisibilityHub" />
    <PackageExport Include="MessageVisibilityHub.fs" Member="messageVisibilityHub" />
  </ItemGroup>
</Project>
